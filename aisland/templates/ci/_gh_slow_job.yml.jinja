
  slow-tests:
    name: Slow Tests
    needs: [quality-gates]
    runs-on: ubuntu-latest
    timeout-minutes: <[ runner_limits['Slow Tests'] ]>
    steps:
    - uses: <[ actions['checkout'] ]>
<% if token_owner %><% include '_gh_token.yml.jinja' %><% endif %>    - name: Set up Python <[ pythons[0] ]>
      uses: <[ actions['setup-python'] ]>
      with:
        python-version: "<[ pythons[0] ]>"
    - name: Install uv
      uses: <[ actions['setup-uv'] ]>
    - name: Install dependencies
      run: |
        <% include '_gh_preinstall.yml.jinja' %>
        uv pip install --system -e ".[<[ extras|join(',') ]>]"<% if browser %>
        playwright install --with-deps <[ browser ]><% endif %>
    - name: Run Slow Tests
      run: |
        rc=0; pytest tests -m slow --junitxml=slow-test-report.xml || rc=$?
        # 5 = the marker is registered but nothing is currently marked — valid, not a failure.
        if [ $rc -ne 0 ] && [ $rc -ne 5 ]; then exit $rc; fi
    - name: Upload Slow Test Results
      uses: <[ actions['upload-artifact'] ]>
      with:
        name: slow-test-results
        path: slow-test-report.xml
      if: always()
