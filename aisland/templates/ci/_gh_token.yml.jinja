    - name: Mint GitHub App token for private <[ token_owner ]> deps
      id: app-token
      uses: <[ actions['create-github-app-token'] ]>
      with:
        app-id: ${{ secrets.<[ token_secret ]>_APP_ID }}
        private-key: ${{ secrets.<[ token_secret ]>_APP_PRIVATE_KEY }}
        owner: <[ token_owner ]>
    - name: Configure git auth for <[ token_owner ]>
      run: git config --global url."https://x-access-token:${{ steps.app-token.outputs.token }}@github.com/".insteadOf "https://github.com/"
