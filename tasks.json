// VS Code tasks of an aisland workspace: open the local Jenkins in VS Code's integrated Simple Browser.
// This file is the copy aisland keeps; `aisland/setup.sh` links `<workspace>/.vscode/tasks.json` to it, so a
// workspace bootstrapped from aisland's checkout has the task. A workspace of its own may copy it.
//
// How it works: each entry of `tasks` is listed under "Tasks: Run Task" (Cmd/Ctrl+Shift+P, or Terminal → Run Task…).
// Running one resolves its `${input:<id>}`, an entry of `inputs` of `type: "command"` that runs `simpleBrowser.show`
// on the url; the task's `echo` only gives the shell task the command it must have.
//
// The url is Jenkins' default port, 9080 (`aisland jenkins info` names the one it runs on). A Jenkins started with
// `aisland jenkins start --port <port>` needs the url below changed to that port.
//
// A task of your own for another service (one a project brings, such as `aisland <service> start`): add a task with
// `"args": ["${input:openX}"]` and an input `{ "id": "openX", "type": "command", "command": "simpleBrowser.show",
// "args": "http://localhost:<its port>" }`; VS Code reloads the list when the file is saved.
{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Open Jenkins (integrated browser)",
            "type": "shell",
            "command": "echo",
            "args": ["${input:openJenkins}"],
            "problemMatcher": [],
            "presentation": {
                "reveal": "silent",
                "panel": "dedicated",
                "close": true
            }
        }
    ],
    "inputs": [
        {
            "id": "openJenkins",
            "type": "command",
            "command": "simpleBrowser.show",
            "args": "http://localhost:9080"
        }
    ]
}
