# Aisland-managed workspace shell init.
#
# This file is owned by aisland — re-running `aisland setup` may overwrite it.
# It is intended to be sourced via a symlink at <workspace>/project.bashrc
# (which `aisland setup` creates).
#
# Put your personal aliases / shell tweaks in <workspace>/user.bashrc instead;
# it is sourced at the bottom of this file and is never touched by aisland.

# Resolve aisland's folder — the one holding this real file and `bin/` — from this script's own
# location, regardless of cwd or whether we were reached via a symlink at the workspace root:
# `aisland/` in a checkout, `.aisland/` when aisland runs from a wheel (`aisland setup` copies
# this file there). Its parent is the workspace root.
_aisland_self="${BASH_SOURCE[0]}"
# If sourced through a symlink (the canonical path), resolve to the real file.
while [ -L "$_aisland_self" ]; do
    _aisland_link_target="$(readlink "$_aisland_self")"
    case "$_aisland_link_target" in
        /*) _aisland_self="$_aisland_link_target" ;;
        *)  _aisland_self="$(cd "$(dirname "$_aisland_self")" && cd "$(dirname "$_aisland_link_target")" && pwd)/$(basename "$_aisland_link_target")" ;;
    esac
done
_aisland_home="$(cd "$(dirname "$_aisland_self")" && pwd)"
# Always this file's workspace, never an inherited PROJECT_ROOT: an editor or terminal started from a
# shell that sourced another workspace passes that one's root down, and its venv would be activated.
export PROJECT_ROOT="$(cd "$_aisland_home/.." && pwd)"
unset _aisland_self _aisland_link_target

# Activate the python virtual environment for this project.
if [ -f "$PROJECT_ROOT/.venv/bin/activate" ]; then
    source "$PROJECT_ROOT/.venv/bin/activate"
fi

# Load environment variables if present: every assignment in `.env` is exported (`set -a`), so a
# quoted value keeps its spaces and `$VAR` in a value expands. A `.env` of only comments exports nothing.
if [ -f "$PROJECT_ROOT/.env" ]; then
    set -a
    source "$PROJECT_ROOT/.env"
    set +a
fi

# Aisland vendors workspace-local tools (jenkins.war, node/npm on Linux, ...)
# under its folder's bin/. Put it on PATH so `aisland provision` can drop binaries
# there without further setup.
case ":$PATH:" in
    *":$_aisland_home/bin:"*) ;;
    *) export PATH="$_aisland_home/bin:$PATH" ;;
esac
unset _aisland_home

# Quick jump back to the workspace root from any subdirectory.
# (An alias of the same name is dropped first: bash would expand it inside the definition.)
unalias cdp cdd cdm cdr h tm 2>/dev/null || true
cdp() { cd "${PROJECT_ROOT}${1:+/$1}"; }
cdd() { cd "${DATA_ROOT}${1:+/$1}"; }
cdm() { cd "${MODEL_ROOT}${1:+/$1}"; }
cdr() { cd "${RUN_DIR}${1:+/$1}"; }

# Tab after one of them completes a folder under its root, at any depth; a name holding a space comes back
# escaped. The word typed so far is unescaped by dropping its backslashes and an opening quote — never `eval`,
# which would run a `$(…)` typed before Tab. Bash 3.2 has no `compopt`, so `nospace` is set at registration.
_aisland_cd_complete() {
    local root cur d
    case "$1" in
        cdp) root=$PROJECT_ROOT ;;
        cdd) root=$DATA_ROOT ;;
        cdm) root=$MODEL_ROOT ;;
        cdr) root=$RUN_DIR ;;
    esac
    COMPREPLY=()
    if [ -z "$root" ] || [ "$COMP_CWORD" -ne 1 ]; then
        return 0
    fi
    cur=${2//\\/}
    cur=${cur#[\'\"]}
    while IFS= read -r d; do
        COMPREPLY+=("$(printf '%q' "${d#"$root"/}")/")
    done < <(compgen -d -- "$root/$cur")
}
complete -o nospace -F _aisland_cd_complete cdp cdd cdm cdr

# The shell history; `h <word>` only the lines holding it, in any case.
h() {
    if [ -z "$1" ]; then
        history
    else
        history | grep -i -- "$1"
    fi
}

# A tmux session in the current folder that carries this shell's environment (the venv, `.env`'s settings):
# a running tmux server otherwise hands a new session the environment it started with. Every exported
# variable goes in as `-e`, read NUL-separated so a value holding a space or newline stays whole; the
# terminal's and tmux's own are left to tmux. Arguments go to `tmux new-session` (`tm -s work`).
tm() {
    local args=() kv
    while IFS= read -r -d '' kv; do
        case "${kv%%=*}" in
            TERM | TERM_PROGRAM* | TMUX | TMUX_PANE | SHLVL | PWD | OLDPWD | _) continue ;;
        esac
        args+=(-e "$kv")
    done < <(env -0)
    tmux new-session -c "$PWD" "${args[@]}" "$@"
}

# Generated by `aisland completion install` (setup.sh calls it; re-run it by
# hand after adding a project). Holds the shared `liquifai-bind-alias` helper,
# one completion block per Liquifai CLI in the venv, and one for the CLIs that
# are not Liquifai apps (aisland, streamstudio). Untracked (see .gitignore) so
# regenerating it never dirties the working tree — which is also why it is a
# separate file rather than content spliced into this committed one.
if [ -f "$PROJECT_ROOT/.project.bashrc.completion" ]; then
    source "$PROJECT_ROOT/.project.bashrc.completion"
fi

# User-owned aliases / customizations. Sourced last so user can override
# anything above.
if [ -f "$PROJECT_ROOT/user.bashrc" ]; then
    source "$PROJECT_ROOT/user.bashrc"
fi
